# Build directories
build/
build-*/
build2/
**/build/
cmake-build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
# Note: Makefile is tracked (not generated) for this project
*.cmake
!CMakeLists.txt

# Compiled binaries
*.o
*.so
*.a
*.dylib
*.dll
*.exe

# Compiled object files
*.obj
*.ko

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (keep .so files in lib/ if they're source dependencies)
# But ignore build outputs
build/**/*.so

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Dependency files
*.d
.deps/

# Temporary files
*.tmp
*.bak
*.log
*.orig

# Test coverage
*.gcov
*.gcda
*.gcno

# Valgrind
vgcore.*

# Qt Creator
*.pro.user
*.pro.user.*

# Autotools
autom4te.cache/
config.status
config.log
configure

# Package files
*.deb
*.rpm
*.tar.gz
*.zip

# Source tarballs (should be downloaded during build, not committed)
eigen.tar.gz
imgui.tar.gz
openvr-headers.tar.gz

# Lib folder (extracted dependencies, not committed)
# But allow lib/imgui source files to be committed
lib/
!lib/imgui/
lib/imgui/.git/
lib/imgui/examples/
lib/imgui/docs/
lib/imgui/misc/
lib/imgui/.github/
lib/imgui/.editorconfig
lib/imgui/.gitignore
lib/imgui/.gitattributes
lib/imgui/README.md
lib/imgui/LICENSE.txt
lib/imgui/*.md
lib/imgui/*.txt

# Local configuration
*.local
.env

# Logs
*.log
driver.log
overlay.log

# ImGui ini files (user preferences)
imgui.ini
**/imgui.ini

# AUR working files at the repo root (the canonical packaging lives in packaging/)
/PKGBUILD
/.SRCINFO
!packaging/PKGBUILD
!packaging/*.install


# AUR staging (generated)
/aur-staging/
